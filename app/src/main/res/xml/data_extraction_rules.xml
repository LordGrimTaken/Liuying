<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusions for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="liuying_account.xml" />
        <exclude domain="sharedpref" path="liuying_update.xml" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="liuying_account.xml" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
