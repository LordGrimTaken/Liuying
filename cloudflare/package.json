{
  "name": "liuying-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "dev": "npm run build && wrangler d1 migrations apply liuying --local && wrangler dev",
    "migrate:local": "wrangler d1 migrations apply liuying --local",
    "migrate": "wrangler d1 migrations apply liuying --remote",
    "deploy": "npm run build && wrangler d1 migrations apply liuying --remote && wrangler deploy",
    "backup": "wrangler d1 export liuying --remote --output=liuying-backup.sql",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
